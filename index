    // --- LEITURA E PROCESSAMENTO DE ARQUIVOS (PDF, DOCX, TXT) ---
    async function handleFileUpload(fileList) {
      if (!fileList || fileList.length === 0) return;

      for (let i = 0; i < fileList.length; i++) {
        const file = fileList[i];
        const fileId = 'doc-' + Date.now() + '-' + Math.random().toString(36).substr(2, 4);
        
        try {
          let text = '';
          if (file.type === 'application/pdf' || file.name.endsWith('.pdf')) {
            text = await extractTextFromPDF(file);
          } else if (file.name.endsWith('.docx')) {
            text = await extractTextFromDOCX(file);
          } else {
            text = await file.text();
          }

          const paragraphs = text.split(/\n\s*\n/).map(p => p.trim()).filter(p => p.length > 0);

          state.files[fileId] = {
            id: fileId,
            name: file.name,
            size: (file.size / 1024 / 1024).toFixed(2) + ' MB',
            text: text,
            paragraphs: paragraphs
          };

          addSystemChatMessage(`✅ Arquivo **"${file.name}"** carregado com sucesso! Pronto para pesquisa de palavras-chave.`);
        } catch (err) {
          console.error(err);
          addSystemChatMessage(`❌ Erro ao ler o arquivo **"${file.name}"**. Certifique-se de que é um documento válido.`);
        }
      }

      saveStateToStorage();
      renderFilesList();
      updateDocFilterSelect();

      // Esconde o welcome banner se já tiver mensagens
      document.getElementById('welcome-banner').classList.add('hidden');
    }

    function extractTextFromPDF(file) {
      return new Promise((resolve, reject) => {
        const reader = new FileReader();
        reader.onload = async function() {
          try {
            const typedarray = new Uint8Array(this.result);
            const pdf = await pdfjsLib.getDocument(typedarray).promise;
            let fullText = '';
            for (let i = 1; i <= pdf.numPages; i++) {
              const page = await pdf.getPage(i);
              const textContent = await page.getTextContent();
              const pageText = textContent.items.map(item => item.str).join(' ');
              fullText += `\n\n--- Página ${i} ---\n\n` + pageText;
            }
            resolve(fullText);
          } catch (e) {
            reject(e);
          }
        };
        reader.readAsArrayBuffer(file);
      });
    }

    function extractTextFromDOCX(file) {
      return new Promise((resolve, reject) => {
        const reader = new FileReader();
        reader.onload = function(e) {
          mammoth.extractRawText({ arrayBuffer: e.target.result })
            .then(result => resolve(result.value))
            .catch(err => reject(err));
        };
        reader.readAsArrayBuffer(file);
      });
    }

    // --- MECANISMO DE BUSCA E CHAT ---
    function executeSearchAndChat(searchTerm) {
      const currentChat = state.chats.find(c => c.id === state.currentChatId);
      if (!currentChat) return;

      // Adiciona mensagem do Usuário
      currentChat.messages.push({ sender: 'user', text: searchTerm, time: new Date().toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'}) });
      
      // Adiciona ao Histórico de Busca
      if (!state.searchHistory.includes(searchTerm)) {
        state.searchHistory.unshift(searchTerm);
      }

      // Parâmetros de Pesquisa
      const filterDocId = document.getElementById('doc-filter-select').value;
      const isExact = document.getElementById('check-exact-match').checked;
      const allowWebFallback = document.getElementById('check-web-fallback').checked;

      let targetFiles = Object.values(state.files);
      if (filterDocId !== 'ALL') {
        targetFiles = targetFiles.filter(f => f.id === filterDocId);
      }

      // Executa filtro nos parágrafos dos arquivos
      let results = [];
      const regex = new RegExp(isExact ? `\\b${escapeRegExp(searchTerm)}\\b` : escapeRegExp(searchTerm), 'gi');

      targetFiles.forEach(file => {
        file.paragraphs.forEach((para, index) => {
          if (regex.test(para)) {
            results.push({
              fileId: file.id,
              fileName: file.name,
              paragraphIndex: index,
              snippet: para
            });
          }
        });
      });

      // Gera Resposta do Assistente
      let botResponse = {
        sender: 'bot',
        searchTerm: searchTerm,
        results: results,
        webFallbackUsed: false,
        time: new Date().toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'})
      };

      if (results.length === 0 && allowWebFallback) {
        botResponse.webFallbackUsed = true;
        botResponse.fallbackInfo = {
          title: `Resultados externos para "${searchTerm}"`,
          summary: `O termo "${searchTerm}" não foi encontrado nos documentos carregados localmente. Em termos médicos/acadêmicos, **${searchTerm}** refere-se ao estudo ou procedimento relacionado à semiologia/diagnóstico clínico.`,
          suggestionUrl: `https://www.google.com/search?q=${encodeURIComponent(searchTerm + ' semiologia medicina')}`
        };
      }

      currentChat.messages.push(botResponse);
      saveStateToStorage();
      renderChatMessages();
      renderHistoryList();

      // Esconde o banner inicial
      document.getElementById('welcome-banner').classList.add('hidden');
    }

